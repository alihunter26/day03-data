/*==============================================================================
   global_paths.do
   Define global path variables used across all scripts
==============================================================================*/

* Set project root (update this path on each machine)
global root ""

* Derived paths
global code    "$root/code"
global data    "$root/data"
global clean   "$root/data/clean"
